1:["$","$Le",null,{"scape":{"slug":"green-retreat","title":"The green retreat","subtitle":"Leafy layers. A natural focal point.","style":"green","image":"/mas-aquarium-studio/explorer/green-retreat.webp","alt":"Illustrative lush green planted aquarium","description":"Explore broad leaves, taller fronds and rooted rosettes. Start with the planting idea, then check each plant against your own tank.","plantingNote":"Keep the attached plants above the substrate and leave space around the rooted rosettes.","points":[{"plant":"anubias","x":21,"y":65},{"plant":"java-fern","x":74,"y":38},{"plant":"crypt","x":61,"y":77}]}}]
