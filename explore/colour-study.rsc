1:["$","$Le",null,{"scape":{"slug":"colour-study","title":"A touch of colour","subtitle":"Green textures with a red accent.","style":"colour","image":"/mas-aquarium-studio/explorer/colour-study.webp","alt":"Illustrative planted aquarium with green and red plant groups","description":"A red stem group adds contrast to the green planting. Look at its light, CO₂ and care requirements before adding it to your list.","plantingNote":"Allow space behind the slower-growing plants for stem growth and regular trimming.","points":[{"plant":"anubias","x":19,"y":71},{"plant":"java-fern","x":25,"y":32},{"plant":"crypt","x":50,"y":73},{"plant":"rotala","x":78,"y":39}]}}]
